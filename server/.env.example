# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=react_network
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Server Configuration
PORT=3001

# Origin of the Vite dev server / deployed client
CLIENT_URL=http://localhost:5173

# Test database (used when NODE_ENV=test)
DB_NAME_TEST=react_network_test

NODE_ENV=development
# Log every SQL statement (noisy)
DB_LOGGING=false